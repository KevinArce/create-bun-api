# Copy to .env (Bun loads it automatically). Every variable is validated in src/config.ts.

# development | test | production
NODE_ENV=development
PORT=3000

# SQLite file path, or :memory:
DATABASE_PATH=data/app.sqlite

# Required. At least 32 characters. Generate one: openssl rand -hex 32
JWT_SECRET=
# Token lifetime in seconds (60 to 2592000)
JWT_TTL_SECONDS=3600

# debug | info | warn | error | silent
LOG_LEVEL=info

# "*" or a comma-separated list of allowed origins
CORS_ORIGIN=*
